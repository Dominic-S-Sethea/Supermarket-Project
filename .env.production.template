# ==============================================================================
# SupermarketOS Production Environment Template (Placeholder-Only)
# Copy to `.env` (gitignored, `chmod 600 .env`) on the target host and replace
# every <GENERATE_...> / <SET_...> placeholder before starting production.
#
# Generate strong random secrets locally:
#   node -e "for (const k of ['POSTGRES_PASSWORD','AUTH_SECRET','ANALYTICS_WORKER_TOKEN','PAYMENT_WEBHOOK_SECRET','METRICS_TOKEN']) console.log(k + '=' + require('crypto').randomBytes(32).toString('hex'))"
#
# Note: infra/docker-compose.prod.yml passes discrete PGHOST/PGPORT/PGUSER/
# PGPASSWORD/PGDATABASE env vars to containers so special password characters
# never break PostgreSQL URI parsing.
# ==============================================================================

# --- Core Runtime & Edge Port ---
NODE_ENV=production
LOG_LEVEL=info
WEB_PORT=8080

# --- PostgreSQL 16 (Required by infra/docker-compose.prod.yml) ---
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=<GENERATE_32B_RANDOM_SECRET>
POSTGRES_DB=supermarket_os
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000

# --- Auth, Session Signing & TLS Reverse Proxy ---
# REQUIRED (>= 32 random chars; never reuse dev/legacy strings)
AUTH_SECRET=<GENERATE_64_HEX_SECRET>
# Populate only during zero-downtime key rotation, then clear after 1 session TTL
AUTH_SECRET_PREVIOUS=
# Set true behind HTTPS ingress forwarding X-Forwarded-Proto: https
COOKIE_SECURE=true
# Number of trusted upstream reverse-proxy hops (or CIDR list)
TRUST_PROXY=1
# Comma-separated production HTTPS browser origins (no trailing slash)
CORS_ORIGINS=https://<SET_YOUR_POS_DOMAIN>

# --- API Docs & Observability ---
# Keep false in hardened production unless internal tooling needs /api/openapi.json
ENABLE_OPENAPI_DOCS=false
# Bearer token required by Prometheus scraper on GET /api/metrics
METRICS_TOKEN=<GENERATE_32B_RANDOM_SECRET>

# --- Store Timezone & POS Timing Guards ---
STORE_TIMEZONE=Asia/Phnom_Penh
POS_MAX_BACKDATE_HOURS=72
POS_MAX_FUTURE_SKEW_SEC=300

# --- Python Analytics HTTP Worker ---
# REQUIRED on both api and analytics containers
ANALYTICS_WORKER_TOKEN=<GENERATE_32B_RANDOM_SECRET>
ANALYTICS_STATEMENT_TIMEOUT_MS=60000
ANALYTICS_LOCK_TIMEOUT_MS=5000

# --- Payment Webhooks (SE Asia QR / Card Gateway) ---
# REQUIRED for HMAC-SHA256 webhook verification (x-payment-signature + x-payment-timestamp)
PAYMENT_WEBHOOK_SECRET=<GENERATE_32B_RANDOM_SECRET>
# Must remain false in production (blocks simulated payment settlement)
ENABLE_SANDBOX_PAYMENT_SIMULATION=false

# --- Gemini AI Copilot (Optional — leave GEMINI_API_KEY empty for deterministic-only mode) ---
GEMINI_API_KEY=
# Keep false so retail prompts are not retained server-side on Gemini
GEMINI_STORE_INTERACTIONS=false
# Keep true so staff/cashier names are pseudonymized before external Gemini calls
AI_REDACT_STAFF_PII=true
GEMINI_COPILOT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_DECISION_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=25000
AI_MAX_PROMO_DISCOUNT_BP=5000
AI_ACTION_TTL_HOURS=24

# --- Frontend Build-Time Safety ---
VITE_ENABLE_DEMO_LOGIN=false
