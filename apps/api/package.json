{
  "name": "@supermarket/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && tsx src/db/applyConstraints.ts",
    "db:migrate:prod": "node dist/db/migrateProd.js",
    "db:push": "drizzle-kit push --force && tsx src/db/applyConstraints.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap-prod": "tsx src/db/bootstrapProd.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@google/genai": "^3.6.1",
    "@supermarket/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "pg": "^8.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^5.1.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.3",
    "vitest": "^5.1.2"
  }
}
