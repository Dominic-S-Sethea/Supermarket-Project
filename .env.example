# SupermarketOS Environment Configuration Template
# Copy to .env and fill in strong secrets before deploying to production.

# --- Core Server ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- PostgreSQL 16 ---
DATABASE_URL=postgres://supermarket:supermarket_dev_password@localhost:5433/supermarket_os
# Optional isolated test database URL used when VITEST=1
# DATABASE_URL_TEST=postgres://supermarket:supermarket_dev_password@localhost:5433/supermarket_os_test
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000

# --- Auth, Session Signing & Key Rotation ---
# REQUIRED outside development/test: unique random string (>= 32 chars) for HMAC-SHA256 sessions
AUTH_SECRET=replace-with-a-random-32-plus-character-secret-in-production
# Optional previous signing key accepted during zero-downtime key rotation
AUTH_SECRET_PREVIOUS=
# Set to true behind TLS termination (automatically true when NODE_ENV=production)
COOKIE_SECURE=false
# Fastify reverse-proxy trust setting ("1", "true", "false", or CIDR list)
TRUST_PROXY=1

# --- CORS, API Docs & Observability ---
# Comma-separated browser origins permitted by CORS & CSRF Origin guard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Set to false to disable /api/openapi.json in hardened deployments
ENABLE_OPENAPI_DOCS=true
# Optional Bearer token for Prometheus scraper access to GET /api/metrics
METRICS_TOKEN=

# --- Analytics HTTP Worker (Python) ---
# When set, POST /api/analytics/shift-diagnostics/recompute calls the worker over HTTP
# instead of spawning a local subprocess.
ANALYTICS_WORKER_URL=http://localhost:8090
ANALYTICS_WORKER_TOKEN=

# --- Gemini AI Copilot (Optional) ---
# When absent, SupermarketOS falls back cleanly to local deterministic tools & lexical search.
GEMINI_API_KEY=
# Keep false (default) so retail prompts are not stored server-side on Gemini
GEMINI_STORE_INTERACTIONS=false

# --- Frontend Dev-Only Flags (Vite) ---
# Must remain unset/false in production builds; enables demo role buttons only when DEV + true
VITE_ENABLE_DEMO_LOGIN=false

# --- Docker Compose Production Overrides ---
POSTGRES_USER=supermarket
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=supermarket_os
WEB_PORT=8080
