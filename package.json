{
  "name": "supermarket-os",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev:api": "pnpm --filter @supermarket/api dev",
    "dev:web": "pnpm --filter @supermarket/web dev",
    "build": "pnpm --filter @supermarket/shared build && pnpm -r --if-present build",
    "lint": "oxlint --deny-warnings -c .oxlintrc.json packages/shared/src apps/api/src apps/web/src",
    "test": "pnpm --filter @supermarket/shared build && pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @supermarket/shared build && pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "test:stress": "node scripts/stress-test.mjs",
    "typecheck": "pnpm --filter @supermarket/shared build && pnpm -r --if-present typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @supermarket/api db:generate",
    "db:migrate": "pnpm --filter @supermarket/api db:migrate",
    "db:push": "pnpm --filter @supermarket/api db:push",
    "db:seed": "pnpm --filter @supermarket/shared build && pnpm --filter @supermarket/api db:seed",
    "db:backup-verify": "bash scripts/db-backup-verify.sh",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "analytics:run": "uv --directory services/analytics run python run_all.py"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "oxlint": "^1.95.0",
    "typescript": "^5.8.2"
  }
}
