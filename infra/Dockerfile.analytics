# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS runner
COPY --from=ghcr.io/astral-sh/uv:0.7.12 /uv /usr/local/bin/uv

WORKDIR /app/services/analytics
COPY services/analytics/pyproject.toml services/analytics/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY services/analytics/run_all.py ./

RUN useradd -r -u 10001 -m analytics && chown -R analytics:analytics /app
USER analytics

ENV ANALYTICS_WORKER_HOST=0.0.0.0
ENV ANALYTICS_WORKER_PORT=8090
EXPOSE 8090

HEALTHCHECK --interval=20s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/app/services/analytics/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=3)"]

# Default: HTTP worker mode so Node API can trigger recomputes cleanly (H-02 / H-24).
# For one-shot cron batch execution, override args with ["run_all.py"].
ENTRYPOINT ["/app/services/analytics/.venv/bin/python"]
CMD ["run_all.py", "--serve"]
